# Local defaults. Copy to .env; never commit real credentials.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
DATABASE_URL=sqlite:///db.sqlite3
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=0
# Optional. Required only when ASGI runs in multiple processes or instances.
CHANNEL_REDIS_URL=
MEDIA_URL=/media/
MEDIA_ROOT=media

# Leave every R2 value empty to use local media (including PythonAnywhere).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_CUSTOM_DOMAIN=
R2_REGION_NAME=auto
R2_MEDIA_LOCATION=media

# Set only when cron-job.org should be allowed to call /ops/run-jobs/.
CRON_SECRET=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://api.monnify.com
